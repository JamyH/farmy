<?xml version="1.0" encoding="utf-8"?>
<!-- Artifact Configuration für das SignPath-Projekt „farmy“. SignPath liest diese Datei nicht aus dem Repo:
     nach der Zusage dort eintragen. Der Parameter version kommt aus .github/workflows/build.yml. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="Farmy" product-version="${version}">
      <include path="Farmy-Setup-${version}.exe" />
      <include path="Farmy-${version}-portable.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
